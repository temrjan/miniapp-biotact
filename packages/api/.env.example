# ═══════════════════════════════════════════════════════════════════
# Biotact API - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git!

# ───────────────────────────────────────────────────────────────────
# Application Settings
# ───────────────────────────────────────────────────────────────────
APP_NAME=Biotact API
DEBUG=false

# ───────────────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/biotact
DATABASE_ECHO=false

# ───────────────────────────────────────────────────────────────────
# Security & Authentication
# ───────────────────────────────────────────────────────────────────
# Generate secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ───────────────────────────────────────────────────────────────────
# CORS Settings
# ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ───────────────────────────────────────────────────────────────────
# Telegram Bot Integration
# ───────────────────────────────────────────────────────────────────
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ───────────────────────────────────────────────────────────────────
# Multicard Payment Gateway
# ───────────────────────────────────────────────────────────────────
MULTICARD_APPLICATION_ID=your-application-id
MULTICARD_SECRET=your-multicard-secret
MULTICARD_STORE_ID=your-store-id
MULTICARD_BASE_URL=https://api.multicard.uz

# ───────────────────────────────────────────────────────────────────
# Optional: Sentry Error Tracking
# ───────────────────────────────────────────────────────────────────
# SENTRY_DSN=your-sentry-dsn-here

# ───────────────────────────────────────────────────────────────────
# Optional: Redis Cache
# ───────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ───────────────────────────────────────────────────────────────────
# AI / OpenAI Configuration
# ───────────────────────────────────────────────────────────────────
# OpenAI API key (or OpenRouter, Yandex GPT, GigaChat via BASE_URL)
OPENAI_API_KEY=sk-your-key-here
# Optional: custom base URL for OpenRouter, Yandex, GigaChat, DeepSeek
# OPENAI_BASE_URL=https://api.openrouter.ai/api/v1
# Embedding model for product search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
