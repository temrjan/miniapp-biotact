# ═══════════════════════════════════════════════════════════════════
# Biotact API - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git!

# ───────────────────────────────────────────────────────────────────
# Application Settings
# ───────────────────────────────────────────────────────────────────
APP_NAME=Biotact API
DEBUG=false

# ───────────────────────────────────────────────────────────────────
# Feature Flags
# ───────────────────────────────────────────────────────────────────
# Biotact Club loyalty program — keep false until the feature is ready
LOYALTY_ENABLED=false

# ───────────────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/biotact
DATABASE_ECHO=false

# ───────────────────────────────────────────────────────────────────
# Security & Authentication
# ───────────────────────────────────────────────────────────────────
# Generate secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ───────────────────────────────────────────────────────────────────
# CORS Settings
# ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ───────────────────────────────────────────────────────────────────
# Telegram Bot Integration
# ───────────────────────────────────────────────────────────────────
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ───────────────────────────────────────────────────────────────────
# Multicard Payment Gateway
# ───────────────────────────────────────────────────────────────────
MULTICARD_APPLICATION_ID=your-application-id
MULTICARD_SECRET=your-multicard-secret
MULTICARD_STORE_ID=your-store-id
MULTICARD_BASE_URL=https://api.multicard.uz

# ───────────────────────────────────────────────────────────────────
# Optional: Sentry Error Tracking
# ───────────────────────────────────────────────────────────────────
# SENTRY_DSN=your-sentry-dsn-here

# ───────────────────────────────────────────────────────────────────
# Optional: Redis Cache
# ───────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# Server-only campaign proxy (optional)
CAMPAIGN_PORTAL_ORIGIN=
CAMPAIGN_SERVICE_TOKEN=

# Employee referral client entry (independent, OFF until authorized activation)
EMPLOYEE_REFERRAL_ENTRY_ENABLED=false

# Buyer browser entry remains disabled until separately authorized activation
BUYER_SESSIONS_ENABLED=false
BUYER_EMAIL_AUTH_ENABLED=false
BUYER_TELEGRAM_AUTH_ENABLED=false
BUYER_PROTECTION_KEY=
BUYER_PUBLIC_ORIGIN=https://biotact.uz
BUYER_TRUSTED_PROXY_PEERS=[]
BUYER_TELEGRAM_BOT_USERNAME=

# Website guest checkout (G1; disabled by default until separately authorized;
# reuses BUYER_PROTECTION_KEY, BUYER_PUBLIC_ORIGIN and BUYER_TRUSTED_PROXY_PEERS;
# PAYMENT_CALLBACK_BASE_URL now serves Mini App and guest payments;
# BUYER_PUBLIC_ORIGIN, PAYMENT_CALLBACK_BASE_URL and MINIAPP_PUBLIC_ORIGIN must be
# exact https:// origins with no path, query, fragment or trailing slash;
# GUEST_TERMS_VERSION and GUEST_PRIVACY_VERSION must be 1-64 printable ASCII
# characters when enabled)
GUEST_CHECKOUT_ENABLED=false
PAYMENT_CALLBACK_BASE_URL=
MINIAPP_PUBLIC_ORIGIN=https://app.biotact.uz
GUEST_TERMS_VERSION=
GUEST_PRIVACY_VERSION=
