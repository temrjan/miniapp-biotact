},
{
"text": "кариес у дочки 4 года",
"kind": "other"
},
{
"text": "bolamning tishlari chiriyapti",
"kind": "other"
},
{
"text": "o'g'lim bukchayib yuradi",
"kind": "other"
},
{
"text": "raxitning oldini olish",
"kind": "other"
},
{
"text": "qizimda karies bor",
"kind": "other"
},
{
"text": "боламнинг тишлари чирияпти",
