# Bot Token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Admin IDs (comma separated telegram user IDs)
ADMIN_IDS=[]

# Mini App URL
WEBAPP_URL=https://your-miniapp-url.com

# Debug mode
DEBUG=false

# Employee referral client entry (independent, OFF until authorized activation)
EMPLOYEE_REFERRAL_ENTRY_ENABLED=false
